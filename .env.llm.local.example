# Copy to .env.llm.local (gitignored), paste your keys, then run:
#   .\.venv\Scripts\python scripts\apply_llm_keys.py
#
# Model fallback order: edit config/llm_models.yaml (see llm_models.example.yaml).

# --- LLM API keys (at least one required) ---
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# --- LLM limits ---
LLM_DAILY_CALL_LIMIT=50
LLM_CHAT_DAILY_CALL_LIMIT=300

# --- Scheduler / prefetch ---
ENABLE_SCHEDULER=true
PREFETCH_SECRET=
