# Copy to .env and set values
APP_PASSWORD=change-me-to-a-strong-password
SESSION_SECRET=change-me-to-a-long-random-string

# --- Phase 1b: optional AI (bubble text) ---
# If all three are unset, /api/today uses static Hungarian fallbacks only.
# GROQ_API_KEY=
# GEMINI_API_KEY=
# OPENROUTER_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile
# GEMINI_MODEL=gemini-2.0-flash
# OPENROUTER_MODEL=google/gemma-2-9b-it:free
# LLM_DAILY_CALL_LIMIT=50

# --- Prefetch (cron / manual warm cache) ---
# Required for POST /internal/prefetch (e.g. Render cron). Not needed for local APScheduler.
# PREFETCH_SECRET=change-me-prefetch-secret
# ENABLE_SCHEDULER=true
