# Copy to .env and set values

# --- App auth ---
APP_PASSWORD=change-me-to-a-strong-password
SESSION_SECRET=change-me-to-a-long-random-string

# --- LLM API keys (at least one required for AI bubbles/chat) ---
# Model lists live in config/llm_models.yaml (copy from llm_models.example.yaml).
# If all three keys are unset, /api/today uses static Hungarian fallbacks only.
# GROQ_API_KEY=
# GEMINI_API_KEY=
# OPENROUTER_API_KEY=

# --- LLM limits ---
# LLM_DAILY_CALL_LIMIT=50
# LLM_CHAT_DAILY_CALL_LIMIT=300

# --- Legacy single-model overrides (optional; used only if llm_models YAML is missing) ---
# GROQ_MODEL=llama-3.3-70b-versatile
# GEMINI_MODEL=gemini-2.0-flash
# OPENROUTER_MODEL=google/gemma-2-9b-it:free

# --- Prefetch (cron / manual warm cache) ---
# Required for POST /internal/prefetch (e.g. Render cron). Not needed for local APScheduler.
# PREFETCH_SECRET=change-me-prefetch-secret
# ENABLE_SCHEDULER=true
